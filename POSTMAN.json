            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "// Si la respuesta es exitosa y trae un token, lo guarda automáticamente",
                            "try {",
                            "    var jsonData = pm.response.json();",
                            "    if (jsonData.token) {",
                            "        pm.collectionVariables.set(\"token\", jsonData.token);",
                            "        console.log(\"Token actualizado automáticamente: \" + jsonData.token);",
                            "    }",
                            "} catch(e) {",
                            "    console.log(\"No se pudo extraer el token de la respuesta\");",
                            "}"
                        ]
                    }
                }
            ]
